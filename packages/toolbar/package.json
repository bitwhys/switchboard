{
	"name": "@switchboard-dev/toolbar",
	"version": "0.0.0",
	"description": "Reference provider of the toolbar@1.0.0 capability: items, badges, panels, mount contract.",
	"keywords": [
		"switchboard",
		"devtools",
		"developer-tools",
		"toolbar",
		"plugin",
		"accessibility"
	],
	"license": "MIT",
	"homepage": "https://github.com/bitwhys/switchboard#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitwhys/switchboard.git",
		"directory": "packages/toolbar"
	},
	"bugs": {
		"url": "https://github.com/bitwhys/switchboard/issues"
	},
	"type": "module",
	"engines": {
		"node": ">=20.19"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@switchboard-dev/core": "workspace:^",
		"@switchboard-dev/ui": "workspace:^"
	},
	"devDependencies": {
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"unrun": "catalog:",
		"vitest": "catalog:"
	}
}

{
	"name": "@switchboard-dev/core",
	"version": "0.0.0",
	"description": "Switchboard kernel: plugin definition, activation, the four primitives, capabilities, permissions, storage.",
	"type": "module",
	"engines": {
		"node": ">=20.19"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"devDependencies": {
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}

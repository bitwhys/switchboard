{
	"name": "@switchboard-dev/bridge-mcp",
	"version": "0.0.0",
	"description": "The page ⇄ agent bridge: Switchboard wire protocol and the MCP edge (Streamable HTTP).",
	"keywords": [
		"switchboard",
		"devtools",
		"developer-tools",
		"mcp",
		"model-context-protocol",
		"ai-agents",
		"bridge"
	],
	"license": "MIT",
	"homepage": "https://github.com/bitwhys/switchboard#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitwhys/switchboard.git",
		"directory": "packages/bridge-mcp"
	},
	"bugs": {
		"url": "https://github.com/bitwhys/switchboard/issues"
	},
	"type": "module",
	"engines": {
		"node": ">=20.19"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./node": {
			"types": "./dist/node.d.ts",
			"default": "./dist/node.js"
		},
		"./web": {
			"types": "./dist/web.d.ts",
			"default": "./dist/web.js"
		}
	},
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@switchboard-dev/core": "workspace:^",
		"ajv": "^8.20.0"
	},
	"devDependencies": {
		"@types/node": "^24.13.3",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"unrun": "catalog:",
		"vitest": "catalog:"
	}
}

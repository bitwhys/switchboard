{
	"name": "@switchboard-dev/adapter-vite",
	"version": "0.0.0",
	"description": "Vite adapter: mounts Switchboard and the bridge MCP edge on the Vite dev server.",
	"keywords": [
		"switchboard",
		"devtools",
		"developer-tools",
		"vite",
		"vite-plugin",
		"mcp",
		"ai-agents"
	],
	"license": "MIT",
	"homepage": "https://github.com/bitwhys/switchboard#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitwhys/switchboard.git",
		"directory": "packages/adapter-vite"
	},
	"bugs": {
		"url": "https://github.com/bitwhys/switchboard/issues"
	},
	"type": "module",
	"engines": {
		"node": ">=20.19"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@switchboard-dev/bridge-mcp": "workspace:^",
		"@switchboard-dev/core": "workspace:^",
		"@switchboard-dev/toolbar": "workspace:^"
	},
	"devDependencies": {
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"unrun": "catalog:",
		"vitest": "catalog:"
	}
}

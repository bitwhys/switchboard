{
	"name": "@switchboard-dev/adapter-vite",
	"version": "0.0.0",
	"description": "Vite adapter: mounts Switchboard and the bridge MCP edge on the Vite dev server.",
	"type": "module",
	"engines": {
		"node": ">=20.19"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@switchboard-dev/core": "workspace:^",
		"@switchboard-dev/bridge-mcp": "workspace:^",
		"@switchboard-dev/toolbar": "workspace:^"
	},
	"devDependencies": {
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}

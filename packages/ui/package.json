{
	"name": "@switchboard-dev/ui",
	"version": "0.0.0",
	"description": "Headless a11y primitives for Switchboard toolbar adapters — plain-DOM factories for the panel-chrome pattern set P1–P8.",
	"type": "module",
	"engines": {
		"node": ">=20.19"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"devDependencies": {
		"@vitest/browser-playwright": "catalog:",
		"axe-core": "catalog:",
		"playwright": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"unrun": "catalog:",
		"vitest": "catalog:"
	}
}
